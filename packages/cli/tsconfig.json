{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"lib": ["ES2024", "DOM"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": true,
		"plugins": [{ "name": "@effect/language-service" }],
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2024"
	},
	"include": ["src/**/*.ts"]
}
