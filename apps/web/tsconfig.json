{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"moduleResolution": "bundler",
		"plugins": [{ "name": "@effect/language-service" }],
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true
	}
}
