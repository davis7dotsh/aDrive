{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "adrive",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"compatibility_date": "2026-07-27",
	"compatibility_flags": ["nodejs_compat"],
	// Local dev defaults. To develop over Tailscale (or any LAN hostname),
	// override both origins in apps/web/.dev.vars — see README "Local setup".
	"vars": {
		"DASHBOARD_ORIGIN": "http://localhost:5173",
		"CONTENT_ORIGIN": "http://localhost:5174",
		"MAX_UPLOAD_BYTES": "99614720",
		"MAX_TOTAL_BYTES": "107374182400",
		"SEMANTIC_SEARCH": "auto",
		"EMBEDDING_MODEL": "@cf/baai/bge-small-en-v1.5",
		"EMBEDDING_POOLING": "cls",
		"EMBEDDING_DIMENSIONS": "384"
	},
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "adrive",
			"database_id": "replace-with-your-d1-database-id",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "adrive"
		}
	],
	"kv_namespaces": [
		{
			"binding": "AUTH_GUARD",
			"id": "419a52adcd9649e0a24e5c47c2748477"
		}
	],
	"observability": {
		"enabled": true,
		"logs": {
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.01
		}
	},
	// Production deploys with `wrangler deploy --env production`. Wrangler
	// environments do not inherit bindings, so everything is redeclared.
	// Before the first deploy (see docs/release.md):
	//   1. Create the production D1 database and paste its id below.
	//   2. Create the production R2 bucket and KV namespace; paste the KV id.
	//   3. Create the Vectorize index and its metadata indexes (docs/release.md).
	//   4. Point DNS for both hostnames at the Worker (routes below).
	//   5. `wrangler secret put PASSCODE --env production`
	//   6. `wrangler d1 migrations apply DB --env production --remote`
	"env": {
		"production": {
			"routes": [
				{ "pattern": "drive.davis7.space", "custom_domain": true },
				{ "pattern": "files.davis7.space", "custom_domain": true }
			],
			"vars": {
				"DASHBOARD_ORIGIN": "https://drive.davis7.space",
				"CONTENT_ORIGIN": "https://files.davis7.space",
				"MAX_UPLOAD_BYTES": "99614720",
				"MAX_TOTAL_BYTES": "107374182400",
				// required (not auto) so a missing AI/Vectorize binding fails
				// the deploy loudly instead of silently degrading to keyword.
				"SEMANTIC_SEARCH": "required",
				"EMBEDDING_MODEL": "@cf/baai/bge-small-en-v1.5",
				"EMBEDDING_POOLING": "cls",
				"EMBEDDING_DIMENSIONS": "384"
			},
			"ai": {
				"binding": "AI"
			},
			"vectorize": [
				{
					"binding": "VECTORIZE",
					"index_name": "adrive-production"
				}
			],
			"triggers": {
				"crons": ["*/5 * * * *"]
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "adrive-production",
					"database_id": "29891a68-07c7-47e4-94db-b0123982fc1f",
					"migrations_dir": "migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "BUCKET",
					"bucket_name": "adrive-production"
				}
			],
			"kv_namespaces": [
				{
					"binding": "AUTH_GUARD",
					"id": "09b884a95e5e40389d8554b3cd690d3f"
				}
			],
			"observability": {
				"enabled": true,
				"logs": {
					"head_sampling_rate": 1
				},
				"traces": {
					"enabled": true,
					"head_sampling_rate": 0.01
				}
			}
		}
	}
	// Local dev runs keyword-only (SEMANTIC_SEARCH=auto, no AI/Vectorize
	// bindings above). Production declares both bindings and uses
	// SEMANTIC_SEARCH=required. To enable semantic search locally, create a
	// 384-dimension cosine index and add the same two bindings to the top
	// level, then run `pnpm types:worker`. See README.md.
}
