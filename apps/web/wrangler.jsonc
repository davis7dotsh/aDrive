{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "adrive",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"compatibility_date": "2026-07-27",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// Local dev defaults. Tenant content is served from
	// `<slug>.<CONTENT_DOMAIN>` over the dashboard's scheme; browsers resolve
	// `*.localhost` to loopback, so no DNS setup is needed. To develop over
	// Tailscale (or any LAN hostname), override both values in
	// apps/web/.dev.vars — see README "Local setup".
	"vars": {
		"DASHBOARD_ORIGIN": "http://localhost:5173",
		"CONTENT_DOMAIN": "localhost:5174",
		"MAX_UPLOAD_BYTES": "99614720",
		"SEMANTIC_SEARCH": "auto",
		"EMBEDDING_MODEL": "@cf/baai/bge-small-en-v1.5",
		"EMBEDDING_POOLING": "cls",
		"EMBEDDING_DIMENSIONS": "384"
	},
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "replace-with-your-hyperdrive-id",
			"localConnectionString": "postgres://adrive:adrive@127.0.0.1:5432/adrive"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "adrive"
		}
	],
	"browser": {
		"binding": "BROWSER"
	},
	"kv_namespaces": [
		{
			"binding": "AUTH_GUARD",
			"id": "419a52adcd9649e0a24e5c47c2748477"
		}
	],
	"queues": {
		"producers": [{ "queue": "adrive-jobs", "binding": "JOBS" }],
		"consumers": [
			{
				"queue": "adrive-jobs",
				"max_batch_size": 5,
				"max_batch_timeout": 5,
				"max_retries": 5,
				"max_concurrency": 10,
				"dead_letter_queue": "adrive-jobs-dlq"
			}
		]
	},
	"observability": {
		"enabled": true,
		"logs": {
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.01
		}
	},
	// Production deploys with `wrangler deploy --env production`. Wrangler
	// environments do not inherit bindings, so everything is redeclared.
	// Before the first deploy (see docs/release.md):
	//   1. Create a Hyperdrive config pointing at PlanetScale Postgres
	//      (direct port 5432, caching disabled) and paste its id below.
	//   2. Create the production R2 bucket and KV namespace; paste the KV id.
	//   3. Create the production job queue and its dead-letter queue
	//      (docs/release.md, "Queues").
	//   4. Point DNS at the Worker: the dashboard custom domain, plus one
	//      proxied wildcard record (`AAAA *.<CONTENT_DOMAIN> 100::`) for
	//      tenant content (routes below). Confirm TLS covers that wildcard:
	//      Universal SSL covers only the zone apex and first-level hosts.
	//      `*.files.davis7.space` needs explicit certificate coverage on the
	//      davis7.space zone, or use a dedicated content-domain zone apex.
	//   5. `wrangler secret put` MAINTENANCE_SECRET, WORKOS_API_KEY,
	//      WORKOS_CLIENT_ID, WORKOS_COOKIE_PASSWORD, WORKOS_WEBHOOK_SECRET
	//      (all `--env production`)
	//   6. `DATABASE_URL=postgres://... bun db:pg:migrate` (see docs/release.md)
	"env": {
		"production": {
			// Place the Worker near the database for dashboard/search queries. Content
			// routes still check visibility in Postgres, then serve from R2 or the
			// Cache API.
			"placement": { "mode": "smart" },
			// Content lives on a wildcard under CONTENT_DOMAIN: one proxied
			// `*.files.davis7.space` DNS record and the route below. Provision a
			// certificate covering that wildcard (for example, an Advanced
			// Certificate); the bare custom domain's certificate does not cover
			// tenant hosts. A dedicated content-domain zone apex replaces this
			// example before launch; update CONTENT_DOMAIN and routes together.
			"routes": [
				{ "pattern": "drive.davis7.space", "custom_domain": true },
				{ "pattern": "files.davis7.space", "custom_domain": true },
				{ "pattern": "*.files.davis7.space/*", "zone_name": "davis7.space" }
			],
			"vars": {
				"DASHBOARD_ORIGIN": "https://drive.davis7.space",
				// A throwaway domain replaces this before launch.
				"CONTENT_DOMAIN": "files.davis7.space",
				"MAX_UPLOAD_BYTES": "99614720",
				// required (not auto) so a missing AI binding fails the deploy
				// loudly instead of silently degrading to keyword search.
				"SEMANTIC_SEARCH": "required",
				"EMBEDDING_MODEL": "@cf/baai/bge-small-en-v1.5",
				"EMBEDDING_POOLING": "cls",
				"EMBEDDING_DIMENSIONS": "384"
			},
			"ai": {
				"binding": "AI"
			},
			"triggers": {
				"crons": ["*/5 * * * *"]
			},
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "replace-with-production-hyperdrive-id"
				}
			],
			"r2_buckets": [
				{
					"binding": "BUCKET",
					"bucket_name": "adrive-production"
				}
			],
			"browser": {
				"binding": "BROWSER"
			},
			"kv_namespaces": [
				{
					"binding": "AUTH_GUARD",
					"id": "09b884a95e5e40389d8554b3cd690d3f"
				}
			],
			"queues": {
				"producers": [{ "queue": "adrive-jobs-production", "binding": "JOBS" }],
				"consumers": [
					{
						"queue": "adrive-jobs-production",
						"max_batch_size": 5,
						"max_batch_timeout": 5,
						"max_retries": 5,
						"max_concurrency": 10,
						"dead_letter_queue": "adrive-jobs-production-dlq"
					}
				]
			},
			"observability": {
				"enabled": true,
				"logs": {
					"head_sampling_rate": 1
				},
				"traces": {
					"enabled": true,
					"head_sampling_rate": 0.01
				}
			}
		}
	}
	// Local dev runs keyword-only (SEMANTIC_SEARCH=auto, no AI binding
	// above). Vectors live in Postgres (pgvector), so production only adds
	// the AI binding and uses SEMANTIC_SEARCH=required. To enable semantic
	// search locally, add the same "ai" binding to the top level, then run
	// `bun --filter @adrive/web types:worker`. See README.md.
}
