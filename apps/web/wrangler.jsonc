{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "adrive",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"compatibility_date": "2026-07-27",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// Local dev defaults. To develop over Tailscale (or any LAN hostname),
	// override both origins in apps/web/.dev.vars — see README "Local setup".
	"vars": {
		"DASHBOARD_ORIGIN": "http://localhost:5173",
		"CONTENT_ORIGIN": "http://localhost:5174",
		"MAX_UPLOAD_BYTES": "99614720",
		"MAX_TOTAL_BYTES": "107374182400",
		"SEMANTIC_SEARCH": "auto",
		"EMBEDDING_MODEL": "@cf/baai/bge-small-en-v1.5",
		"EMBEDDING_POOLING": "cls",
		"EMBEDDING_DIMENSIONS": "384"
	},
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "replace-with-your-hyperdrive-id",
			"localConnectionString": "postgres://adrive:adrive@127.0.0.1:5432/adrive"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "adrive"
		}
	],
	"browser": {
		"binding": "BROWSER"
	},
	"kv_namespaces": [
		{
			"binding": "AUTH_GUARD",
			"id": "419a52adcd9649e0a24e5c47c2748477"
		}
	],
	"observability": {
		"enabled": true,
		"logs": {
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.01
		}
	},
	// Production deploys with `wrangler deploy --env production`. Wrangler
	// environments do not inherit bindings, so everything is redeclared.
	// Before the first deploy (see docs/release.md):
	//   1. Create the production D1 database and paste its id below.
	//   1b. Create a Hyperdrive config pointing at PlanetScale Postgres
	//       (direct port 5432, caching disabled) and paste its id below.
	//   2. Create the production R2 bucket and KV namespace; paste the KV id.
	//   3. Point DNS for both hostnames at the Worker (routes below).
	//   4. `wrangler secret put PASSCODE --env production`
	//   5. `DATABASE_URL=postgres://... bun db:pg:migrate` (see docs/release.md)
	"env": {
		"production": {
			// Place the Worker near D1 for dashboard/search queries. Content
			// routes still check visibility in D1, then serve from R2 or the
			// Cache API.
			"placement": { "mode": "smart" },
			"routes": [
				{ "pattern": "drive.davis7.space", "custom_domain": true },
				{ "pattern": "files.davis7.space", "custom_domain": true }
			],
			"vars": {
				"DASHBOARD_ORIGIN": "https://drive.davis7.space",
				"CONTENT_ORIGIN": "https://files.davis7.space",
				"MAX_UPLOAD_BYTES": "99614720",
				"MAX_TOTAL_BYTES": "107374182400",
				// required (not auto) so a missing AI binding fails the deploy
				// loudly instead of silently degrading to keyword search.
				"SEMANTIC_SEARCH": "required",
				"EMBEDDING_MODEL": "@cf/baai/bge-small-en-v1.5",
				"EMBEDDING_POOLING": "cls",
				"EMBEDDING_DIMENSIONS": "384"
			},
			"ai": {
				"binding": "AI"
			},
			"triggers": {
				"crons": ["*/5 * * * *"]
			},
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "replace-with-production-hyperdrive-id"
				}
			],
			"r2_buckets": [
				{
					"binding": "BUCKET",
					"bucket_name": "adrive-production"
				}
			],
			"browser": {
				"binding": "BROWSER"
			},
			"kv_namespaces": [
				{
					"binding": "AUTH_GUARD",
					"id": "09b884a95e5e40389d8554b3cd690d3f"
				}
			],
			"observability": {
				"enabled": true,
				"logs": {
					"head_sampling_rate": 1
				},
				"traces": {
					"enabled": true,
					"head_sampling_rate": 0.01
				}
			}
		}
	}
	// Local dev runs keyword-only (SEMANTIC_SEARCH=auto, no AI binding
	// above). Vectors live in Postgres (pgvector), so production only adds
	// the AI binding and uses SEMANTIC_SEARCH=required. To enable semantic
	// search locally, add the same "ai" binding to the top level, then run
	// `bun --filter @adrive/web types:worker`. See README.md.
}
