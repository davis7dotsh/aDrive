# Copy to backup.env next to backup.sh, fill in, then: chmod 600 backup.env
# backup.env is gitignored — never commit the real file.

# Where backups land on the backup host.
BACKUP_ROOT="${HOME}/Backups/a-drive"

# rclone remote for the production R2 bucket, as remote:bucket.
# Configure with: rclone config create adrive-r2 s3 provider=Cloudflare \
#   access_key_id=... secret_access_key=... \
#   endpoint=https://<account-id>.r2.cloudflarestorage.com
# Use an R2 API token scoped to READ-ONLY on the adrive-production bucket.
RCLONE_REMOTE="adrive-r2:adrive-production"

# Read-only Postgres role on the production database (PlanetScale direct
# port 5432). pg_dump must be installed on the backup host.
DATABASE_URL=""

# Where failures and anomalies are announced (ntfy topic, Discord webhook,
# or similar). Posts {"text": "..."} JSON. Leave empty to log only.
ALERT_WEBHOOK_URL=""

# Alert if the mirrored object count shrinks by more than this in one run.
SHRINK_TOLERANCE=100
